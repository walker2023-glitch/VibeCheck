# Copy this file to .env on the homelab. Never commit the real .env.
VIBECHECK_PORT=3000

# Set this to the exact browser origin when mutating requests are enabled.
# Example: http://192.168.1.50:3000
APP_ORIGIN=

# Leave AI unset for deterministic explanations.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_CONCEPT=
