# Set to true to use contract-shaped development fixtures (not live analysis).
# Set to false when the backend /api/v1 is available.
NEXT_PUBLIC_USE_FIXTURES=true

# Same-origin API base for the hackathon deployment.
# The intended integrated deploy is one Next.js app serving UI and /api/v1 together,
# so browsers call same-origin /api/v1 and do not need separate CORS configuration.
# Do not change this away from /api/v1 for the normal hackathon deployment.
NEXT_PUBLIC_API_BASE=/api/v1

# Public browser origin for production behind a reverse proxy (scheme + host, optional port).
# Example: https://your-service.up.railway.app
# When set, mutating API requests must present this exact Origin. Leave unset for local dev.
# APP_ORIGIN=https://your-service.up.railway.app
